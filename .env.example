# --- Security & Cloudflare Access ---
# Set to true ONLY for local development without Cloudflare Tunnel.
LOCAL_DEV_MODE=false

# Your Cloudflare Zero Trust team domain (e.g., https://myteam.cloudflareaccess.com)
CF_TEAM_DOMAIN=
# Your Cloudflare Access Application Audience (AUD) Tag
CF_POLICY_AUD=

# --- Storage & App ---
DATA_DIR=/data
SEED_FILE=/app/seed.json
MAX_UPLOAD_MB=10

# --- Remote MCP Endpoint (/mcp) ---
# Set MCP_ENABLED=true to expose a stateless Streamable HTTP MCP server at POST /mcp.
# Protected by Cloudflare Access (use a Cloudflare Access Service Token) when LOCAL_DEV_MODE=false.
MCP_ENABLED=false
# Set to true to hard-lock MCP to read/search/planning tools (blocks all writes & deletes).
MCP_READ_ONLY=false
# Optional second-layer Bearer token (Authorization: Bearer <token>). Leave blank to rely solely on Cloudflare Access.
MCP_API_TOKEN=
