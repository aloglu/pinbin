# --- Security & Cloudflare Access ---
# Set to true ONLY for local development without Cloudflare Tunnel.
LOCAL_DEV_MODE=false

# Your Cloudflare Zero Trust team domain (e.g., https://myteam.cloudflareaccess.com)
CF_TEAM_DOMAIN=
# Your Cloudflare Access Application Audience (AUD) Tag
CF_POLICY_AUD=

# --- Optional AI Smart Autofill (Server-side only, NEVER exported) ---
# Leave AI_API_KEY blank to disable AI enrichment gracefully.
# Supported providers: "gemini" (default), "openai_compat", "openai", or "openrouter"
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
# Only needed if AI_PROVIDER=openai_compat (e.g., https://api.openai.com/v1 or https://openrouter.ai/api/v1)
AI_BASE_URL=
# Optional for reasoning models (e.g., low, medium, high, none)
AI_REASONING_EFFORT=
# Hard daily request cap to protect API billing
AI_DAILY_LIMIT=30

# --- Storage & App ---
DATA_DIR=/data
SEED_FILE=/app/seed.json
MAX_UPLOAD_MB=10
